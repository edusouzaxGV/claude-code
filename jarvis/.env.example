# ============================================================================
# ZEMARK configuration — copy to `.env` and adjust. Everything has a sane
# default; the only thing you really need is subscription auth (below).
# ============================================================================

# --- Brain (Claude, via your Pro/Max subscription — NO paid API key) --------
# Generate once with:  claude setup-token   (needs the Claude Code CLI)
CLAUDE_CODE_OAUTH_TOKEN=

# If ANTHROPIC_API_KEY is set anywhere it SILENTLY overrides the subscription
# token and bills you. ZEMARK strips it by default; set to 0 only if you WANT
# to pay per token with an API key.
ZEMARK_FORCE_SUBSCRIPTION_AUTH=1

ZEMARK_BRAIN_MODEL=sonnet          # sonnet | haiku | opus | full model id
ZEMARK_MAX_REPLY_SENTENCES=3
ZEMARK_PERMISSION_MODE=bypassPermissions

# --- Who ---------------------------------------------------------------------
ZEMARK_ASSISTANT_NAME=ZEMARK
ZEMARK_USER_NAME=chefe

# --- Speech-to-text ----------------------------------------------------------
# groq   = free tier, fast, no credit card (key at console.groq.com)
# whisper= fully local (faster-whisper, CPU/int8 on Apple Silicon)
ZEMARK_STT_PROVIDER=groq
GROQ_API_KEY=
ZEMARK_STT_GROQ_MODEL=whisper-large-v3-turbo
ZEMARK_STT_WHISPER_MODEL=small
ZEMARK_STT_WHISPER_DEVICE=cpu
ZEMARK_STT_WHISPER_COMPUTE=int8
ZEMARK_STT_LANGUAGE=pt

# --- Text-to-speech (Kokoro, local, free, ~24kHz) ---------------------------
ZEMARK_TTS_PROVIDER=kokoro
ZEMARK_TTS_VOICE=pf_dora           # pt-br voices: pf_dora (fem), pm_alex (masc),
                                   # pm_santa (masc). af_heart = English.
ZEMARK_TTS_LANGUAGE=pt-br
ZEMARK_TTS_SPEED=1.0
# Only needed for the LiveKit path (download once — see README):
# ZEMARK_KOKORO_ONNX=models/kokoro-v1.0.onnx
# ZEMARK_KOKORO_VOICES=models/voices-v1.0.bin

# --- Wake word ("ZEMARK") ----------------------------------------------------
# stt_phrase   = zero setup, works on day one (default)
# porcupine    = custom .ppn from Picovoice console (native macOS, low power)
# openwakeword = custom .onnx trained in the official Colab notebook
ZEMARK_WAKE_BACKEND=stt_phrase
ZEMARK_WAKE_WORD=zemark
ZEMARK_WAKE_ALIASES=zemark,ze mark,zé mark,zi mark,zemarki,zemarck,z mark
ZEMARK_WAKE_THRESHOLD=0.5
# PICOVOICE_ACCESS_KEY=
# ZEMARK_PORCUPINE_PPN=models/zemark_mac.ppn
# ZEMARK_OWW_ONNX=models/ZEMARK.onnx

# --- Memory + auto-learning --------------------------------------------------
ZEMARK_AUTO_LEARN=1
ZEMARK_RECALL_LIMIT=6
ZEMARK_MEMORY_MIN_CONFIDENCE=0.55
# ZEMARK_MEMORY_DB=data/memory.sqlite3

# --- Proactivity (ZEMARK speaks first) --------------------------------------
ZEMARK_PROACTIVE=1
ZEMARK_PROACTIVE_TICK=30
ZEMARK_PROACTIVE_MIN_GAP=600        # seconds between proactive nudges
ZEMARK_QUIET_START=23               # quiet hours (local 24h clock)
ZEMARK_QUIET_END=8

# --- Audio / conversation ----------------------------------------------------
ZEMARK_IDLE_TIMEOUT=45              # seconds of silence before wake word needed again
