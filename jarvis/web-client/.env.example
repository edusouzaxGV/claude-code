# LiveKit connection details, shared by the token server and (URL only) the browser.
# Copy this file to `.env` and fill in real values.
#
# Find these in the LiveKit Cloud dashboard (Settings -> Keys), or from your
# self-hosted server config. They MUST match the same LiveKit project the
# Python "zemark" agent registers with.

# wss URL of your LiveKit server, e.g. wss://my-project.livekit.cloud
LIVEKIT_URL=wss://your-project.livekit.cloud

# API key / secret used ONLY by the token server to mint access tokens.
# NEVER expose the secret to the browser.
LIVEKIT_API_KEY=your_api_key
LIVEKIT_API_SECRET=your_api_secret

# Port the token server listens on (optional, defaults to 3001).
TOKEN_SERVER_PORT=3001
